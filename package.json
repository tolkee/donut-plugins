{
  "name": "donut-plugins",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p kit/plugin-build/tsconfig.json --noEmit",
    "audit": "pnpm audit --prod",
    "verify-kit": "node scripts/verify-kit.ts"
  },
  "devDependencies": {
    "@donut/plugin-build": "workspace:*",
    "@donut/protocol": "workspace:*",
    "@donut/sdk": "workspace:*",
    "@donut/ui": "workspace:*",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
